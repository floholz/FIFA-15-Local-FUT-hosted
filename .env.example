# Copy to .env and fill in. docker compose reads .env automatically, so every
# `docker compose` command (up/logs/restart) picks these up with no prefixing.

# --- OUFT web app / accounts ---
# The public IPv4 the web app listens on (80/443). Only this address is bound.
OUFT_PUBLIC_IP=203.0.113.10
# Domain of the web app (register links, login). Its DNS A record must point at OUFT_PUBLIC_IP.
OUFT_DOMAIN=ouft.example.com
# Let's Encrypt account email (expiry notices).
OUFT_ACME_EMAIL=you@example.com
# Keys game servers use for the internal API, name:key pairs (generate: openssl rand -hex 32).
OUFT_SERVICE_KEYS=fut15:replace-with-a-long-random-key
# Host port for that internal API (127.0.0.1 only).
#OUFT_ACCOUNTS_LOCAL_PORT=8095

# --- FIFA 15 game server ---
# Where users, clubs and logs live (bind-mounted to /data). Keep an existing server's
# clubs by pointing this at its state directory, e.g. /home/you/.local/share/fifa15-local-fut-server
#FUT15_STATE_DIR=./data/fut15
# Owner of that directory (the container runs as this user).
#FUT15_UID=1000
#FUT15_GID=1000
# 1 = only OUFT account logins (refuse launchers before 15.1).
#FUT15_REQUIRE_ACCOUNT=0
# The address players connect to (DNS name or VPS IP).
PUBLIC_HOST=fut15.example.com
# Friend gate: clients must send this code to register (empty/omit = open server).
SERVER_ACCESS_CODE=change-me
# Optional: only these comma-separated names may register.
#ALLOWED_PLAYERS=kyro,flo,sam
