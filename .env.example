# Copy to .env and fill in. docker compose reads .env automatically, so every
# `docker compose` command (up/logs/restart) picks these up with no prefixing.

# REQUIRED: the address players connect to (your CNAME/domain or VPS IP).
PUBLIC_HOST=fifa.example.com

# Friend gate: clients must send this code to register (empty/omit = open server).
SERVER_ACCESS_CODE=change-me

# Optional: only these comma-separated names may register.
#ALLOWED_PLAYERS=kyro,flo,sam
